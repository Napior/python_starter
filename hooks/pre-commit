#!/usr/bin/env bash
set -e

PYTHON=".venv/bin/python"

if [ ! -f "$PYTHON" ]; then
    echo "ERROR: venv not found. Run: python3.12 -m venv .venv && pip install -r requirements.txt"
    exit 1
fi

echo ">>> isort --check-only"
$PYTHON -m isort --check-only src/ ui/

echo ">>> black --check"
$PYTHON -m black --check src/ ui/

echo ">>> flake8"
$PYTHON -m flake8 src/ ui/

echo ">>> mypy"
$PYTHON -m mypy src/
